{
  "name": "matabot-india-election-assistant",
  "version": "1.0.0",
  "description": "India Election Intelligence Assistant powered by Groq + Firebase + Google Services",
  "main": "src/app.js",
  "scripts": {
    "start": "npx serve public -l 3000",
    "test": "npx jest --coverage",
    "lint": "npx eslint src/**/*.js",
    "deploy": "firebase deploy",
    "deploy:hosting": "firebase deploy --only hosting",
    "deploy:functions": "firebase deploy --only functions",
    "build": "echo 'Static site - no build step required'"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "collectCoverageFrom": ["src/**/*.js"]
  },
  "keywords": ["india", "election", "ECI", "voting", "firebase", "groq", "accessibility"],
  "license": "MIT"
}
